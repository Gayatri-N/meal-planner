      ],
      "steps": [
        { "en": "Whisk the besan with 300 ml water and a little salt into a smooth batter with no lumps.", "mr": "बेसनात ३०० मिली पाणी आणि थोडं मीठ घालून गुठळ्या न राहता एकजीव करा." },
        { "en": "Heat the oil; add the mustard and cumin seeds, then the garlic, green chillies and curry leaves.", "mr": "तेल गरम करून मोहरी, जिरे घाला; मग लसूण, हिरवी मिरची आणि कढीपत्ता घाला." },
        { "en": "Add the onion and cook until soft, then add the turmeric.", "mr": "कांदा घालून मऊ होईपर्यंत परता, मग हळद घाला." },
        { "en": "Pour in the batter while stirring and cook on low heat for 5–7 minutes, until thick and no longer raw-smelling.", "mr": "सतत ढवळत पीठ ओता आणि घट्ट होऊन कच्चा वास जाईपर्यंत मंद आचेवर ५–७ मिनिटे शिजवा." },
        { "en": "Cover for a minute, garnish with coriander and serve hot with bhakri.", "mr": "एक मिनिट झाकण ठेवा, कोथिंबीर घालून भाकरीसोबत गरम वाढा." }
      ]
