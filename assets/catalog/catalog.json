        { "ingredientId": "coriander_leaves", "qty": 2, "unit": "tbsp" }
      ],
      "steps": [
        { "en": "Rinse the poha in a sieve under running water for a few seconds, drain, and let it soften for 5 minutes.", "mr": "पोहे चाळणीत घेऊन पाण्याखाली काही सेकंद धुवा, पाणी निथळू द्या आणि ५ मिनिटे मऊ होऊ द्या." },
        { "en": "Mix the salt and sugar into the poha.", "mr": "पोह्यांना मीठ आणि साखर लावून घ्या." },
        { "en": "Heat the oil, fry the peanuts until crisp, then add the mustard seeds and let them splutter.", "mr": "तेल गरम करून शेंगदाणे कुरकुरीत तळा, मग मोहरी घालून तडतडू द्या." },
        { "en": "Add the curry leaves, green chillies and onion; cook until the onion is soft.", "mr": "कढीपत्ता, हिरवी मिरची आणि कांदा घालून कांदा मऊ होईपर्यंत परता." },
        { "en": "Add the turmeric, then the poha. Mix gently, cover and steam on low heat for 2–3 minutes.", "mr": "हळद घाला, मग पोहे घालून हलक्या हाताने मिसळा. झाकण ठेवून मंद आचेवर २–३ मिनिटे वाफ काढा." },
        { "en": "Finish with lemon juice and coriander.", "mr": "वरून लिंबाचा रस आणि कोथिंबीर घाला." }
      ]
    },
